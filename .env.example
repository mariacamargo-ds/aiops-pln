# Copie para ".env" e preencha. NUNCA coloque o .env no Teams, no GitHub nem em prints.

# --- Banco ---------------------------------------------------------------
# Padrão (sem configurar nada): SQLite em data/aiops.db
# PostgreSQL 18:   (troque SENHA; o banco "aiops" precisa existir)
# DATABASE_URL=postgresql+psycopg://postgres:SENHA@localhost:5432/aiops

# --- Qual modelo gera as respostas? ----------------------------------------
# deepseek = nuvem (paga por token)  |  ollama = modelo LOCAL, gratuito  |  off = sem IA (resposta extrativa)
# Local: instale o Ollama (ollama.com) e rode:  ollama pull qwen2.5:3b     (notebook de 8 GB de RAM)
# Dá para trocar de modo na tela Configuração, sem reiniciar.
LLM_PROVIDER=deepseek
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- DeepSeek (só se LLM_PROVIDER=deepseek) -------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ID do modelo exatamente como aparece no painel da DeepSeek:
DEEPSEEK_MODEL=deepseek-chat

# --- Embeddings ----------------------------------------------------------
# hash = offline, sem download (padrão)   |   st = semântico (pip install sentence-transformers)
EMBEDDER=hash
# ST_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Busca ---------------------------------------------------------------
# TOP_K=24
# CONTEXT_PASSAGES=10
# SENSITIVITY_DEFAULT=0.5
